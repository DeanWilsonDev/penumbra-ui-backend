// Nyx-authored Application demo for the Penumbra UI backend. The backend owns
// the Nyx bridge while Penumbra remains responsible for the native frame loop.
DemoApplication :: class : Application {
public:
    OnStart~: () -> bool override {
        log("OnStart: DemoApplication is alive, running inside Penumbra::Application::Run()");
        this.SetRootWidget(createDemoRoot());
        guard windowSize := this.GetWindowLogicalSize() return false;
        inspectApplicationHandles(
            windowSize.X(), windowSize.Y(), this.GetDpiScaleFactor(), this.GetFontBackend(),
            this.GetLifecycleRegistry(), this.GetRootWidget());
        return true;
    }

    OnUpdate~: (deltaTime: f32) -> void override {
        if tick(deltaTime) {
            this.RequestQuit();
        }
    }

    OnShutdown~: () -> void override {
        this.SetRootWidget(null);
        log("OnShutdown: DemoApplication tearing down");
    }
}
